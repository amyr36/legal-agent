# .env.example — environment variables for the Legal Document Comparison MVP.
#
# NOTE (current state of the code): NO variable below is actually read by the
# project yet. `services/analyses_service.py` reads exactly ONE env var:
#   LEGAL_SIM_REBUILD=1  → force FAISS rebuild (same as POST /analyze {"rebuild": true})
# The LLM API key is HARDCODED in services/analyses_service.py (deliberate MVP
# choice per spec). This file documents the runtime configuration knobs and the
# values the code actually uses, so future work can wire them up as env vars
# (see "Future Extension Points → API key via environment variable" in STATUS.md).

# --- LLM (currently hardcoded in services/analyses_service.py) ---
# ChatOpenAI(base_url=..., model=...) — the ONLY supported change-point today
# is editing the constants in that file. Values below are what the code uses:
# CHAT_MODEL_BASE_URL=https://api.avalai.ir/v1
# CHAT_MODEL_NAME=glm-5.3-flash
# CHAT_MODEL_API_KEY=aa-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Pipeline behavior (real env var, read by analyses_service.run_analysis) ---
# Force a FAISS rebuild even when the fingerprint matches (recreate
# sources/temp/document_A|B/faiss/):
# LEGAL_SIM_REBUILD=0

# --- Windows console readability for Persian logs (optional, OS-level) ---
# PYTHONIOENCODING=utf-8

# --- Embedding model (currently the local path constant
# EMBEDDING_MODEL="models/sentence-transformer-parsbert-fa-2.0" in
# services/vector_store_service.py; the folder is gitignored and must be
# re-provided on a fresh clone) ---
# EMBEDDING_MODEL=models/sentence-transformer-parsbert-fa-2.0
