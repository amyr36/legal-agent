# ===========================
# PostgreSQL (docker-compose)
# ===========================
POSTGRES_DB=legal-agent
POSTGRES_USER=legal-agent
POSTGRES_PASSWORD=change-me

# Used by the backend. The hostname must be the compose service name.
DATABASE_URL=postgresql+psycopg://legal-agent:change-me@postgres:5432/legal-agent

# ===========================
# JWT auth
# ===========================
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================
# SMS (optional, not used by the API yet)
# ===========================
MELIPAYAMAK_USERNAME=your-username
MELIPAYAMAK_PASSWORD=your-password
MELIPAYAMAK_SENDER=50004001001516

# ===========================
# LLM provider (avalai, OpenAI-compatible)
# Used by document structuring (text_to_json) and the analysis pipeline.
# ===========================
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=deepseek-v4.1-flash
STRUCTURE_MODEL=deepseek-v4.1-flash

# ===========================
# FastAPI (optional overrides)
# ===========================
APP_NAME=Legal Agent
DEBUG=False
AUTO_CREATE_TABLES=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
